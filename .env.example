# Backend Environment Variables
LLM_API_KEYS=your_first_gemini_or_openai_key,your_second_gemini_or_openai_key
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_FAILURE_SIMULATION=true
LLM_MODEL=gemini/gemini-3.5-flash-lite
FALLBACK_MODELS=gemini/gemini-3-flash-preview
DEFAULT_SYSTEM_PROMPT=You are a helpful, accurate, and concise AI assistant.

# Optional: set to true to test without real API keys
MOCK_LLM=false

# Frontend Environment Variables (for deployment)
VITE_BACKEND_URL=http://localhost:8000
